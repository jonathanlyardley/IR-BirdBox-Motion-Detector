# Copy this file to .env on your Raspberry Pi and edit the values.
# Keep .env private. Do not commit it to GitHub.

BIRDBOX_ROOT=/home/pi/birdbox
BIRDBOX_STREAM_HOST=birdbox.local
BIRDBOX_STREAM_PORT=8080
BIRDBOX_IR_GPIO_PIN=18

# Recording and output paths
BIRDBOX_RECORD_SCRIPT=/home/pi/birdbox/bin/record15.sh
BIRDBOX_CLIPS_DIR=/home/pi/birdbox/clips
BIRDBOX_LOG_FILE=/home/pi/birdbox/logs/events.log

# Optional Wi-Fi power-saving controls.
# Disable these if you have not created matching systemd services.
BIRDBOX_ENSURE_SSH_RUNNING=false
BIRDBOX_WIFI_IDLE_AUTO_OFF=false
BIRDBOX_WIFI_OFF_HOUR_START=0
BIRDBOX_WIFI_OFF_HOUR_END=7
BIRDBOX_ALWAYS_WIFI_ON_FLAG=/home/pi/birdbox/always_wifi_on
BIRDBOX_WIFI_ON_SERVICE=birdbox-wifi-on.service
BIRDBOX_WIFI_OFF_SERVICE=birdbox-wifi-off.service
BIRDBOX_WIFI_UNTIL_PATH=/run/birdbox/wifi_on_until

# Optional email notifications.
# Leave BIRDBOX_SMTP_HOST blank to disable email safely.
BIRDBOX_EMAIL_ENABLED=true
BIRDBOX_EMAIL_COOLDOWN_SECS=300
BIRDBOX_SMTP_HOST=
BIRDBOX_SMTP_PORT=465
BIRDBOX_EMAIL_FROM=
BIRDBOX_EMAIL_PASSWORD=
BIRDBOX_EMAIL_TO=
